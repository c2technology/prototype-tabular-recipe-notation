{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Invite-only Cognito Google OAuth configuration for the TRN prototype.",
  "Parameters": {
    "EnvironmentName": {
      "Type": "String",
      "Default": "prototype",
      "AllowedPattern": "[a-zA-Z0-9-]+"
    },
    "GoogleClientId": {
      "Type": "String",
      "NoEcho": true,
      "Description": "Google OAuth client id supplied at deploy time. Do not commit real values."
    },
    "GoogleClientSecret": {
      "Type": "String",
      "NoEcho": true,
      "Description": "Google OAuth client secret supplied at deploy time. Do not commit real values."
    },
    "CallbackUrls": {
      "Type": "CommaDelimitedList",
      "Description": "Allowed OAuth callback URLs for the frontend/app client."
    },
    "LogoutUrls": {
      "Type": "CommaDelimitedList",
      "Description": "Allowed OAuth logout URLs for the frontend/app client."
    },
    "HostedUiDomainPrefix": {
      "Type": "String",
      "Description": "Globally unique Cognito hosted UI domain prefix for this prototype environment.",
      "AllowedPattern": "[a-z0-9-]+"
    }
  },
  "Resources": {
    "PreSignUpFunctionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {"Service": "lambda.amazonaws.com"},
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "invite-only-cognito-pre-signup",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
                  "Resource": "arn:aws:logs:*:*:*"
                },
                {
                  "Effect": "Allow",
                  "Action": "cognito-idp:ListUsers",
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "InviteOnlyPreSignUpFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "python3.11",
        "Handler": "index.handler",
        "Role": {"Fn::GetAtt": ["PreSignUpFunctionRole", "Arn"]},
        "Timeout": 10,
        "MemorySize": 128,
        "Code": {
          "ZipFile": "import boto3\n\nclient = boto3.client(\"cognito-idp\")\n\ndef handler(event, context):\n    del context\n    email = event.get(\"request\", {}).get(\"userAttributes\", {}).get(\"email\")\n    if not email:\n        raise Exception(\"Google account must provide a verified email address\")\n\n    users = client.list_users(\n        UserPoolId=event[\"userPoolId\"],\n        Filter=f'email = \\\"{email}\\\"',\n        Limit=5,\n    ).get(\"Users\", [])\n\n    invited_users = [\n        user for user in users\n        if not user.get(\"Username\", \"\").lower().startswith(\"google_\")\n    ]\n    if not invited_users:\n        raise Exception(\"User is not invited\")\n\n    return event\n"
        }
      }
    },
    "TrnUserPool": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "UserPoolName": {"Fn::Sub": "trn-${EnvironmentName}-users"},
        "UsernameAttributes": ["email"],
        "AutoVerifiedAttributes": ["email"],
        "AdminCreateUserConfig": {
          "AllowAdminCreateUserOnly": true
        },
        "LambdaConfig": {
          "PreSignUp": {"Fn::GetAtt": ["InviteOnlyPreSignUpFunction", "Arn"]}
        },
        "Schema": [
          {
            "Name": "email",
            "Required": true,
            "Mutable": true
          }
        ]
      }
    },
    "PreSignUpInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {"Ref": "InviteOnlyPreSignUpFunction"},
        "Principal": "cognito-idp.amazonaws.com",
        "SourceArn": {"Fn::GetAtt": ["TrnUserPool", "Arn"]}
      }
    },
    "GoogleIdentityProvider": {
      "Type": "AWS::Cognito::UserPoolIdentityProvider",
      "Properties": {
        "UserPoolId": {"Ref": "TrnUserPool"},
        "ProviderName": "Google",
        "ProviderType": "Google",
        "ProviderDetails": {
          "client_id": {"Ref": "GoogleClientId"},
          "client_secret": {"Ref": "GoogleClientSecret"},
          "authorize_scopes": "openid email profile"
        },
        "AttributeMapping": {
          "email": "email",
          "email_verified": "email_verified",
          "given_name": "given_name",
          "family_name": "family_name",
          "name": "name"
        }
      }
    },
    "TrnUserPoolClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "DependsOn": "GoogleIdentityProvider",
      "Properties": {
        "ClientName": {"Fn::Sub": "trn-${EnvironmentName}-web"},
        "UserPoolId": {"Ref": "TrnUserPool"},
        "GenerateSecret": false,
        "SupportedIdentityProviders": ["COGNITO", "Google"],
        "AllowedOAuthFlowsUserPoolClient": true,
        "AllowedOAuthFlows": ["code"],
        "AllowedOAuthScopes": ["openid", "email", "profile"],
        "CallbackURLs": {"Ref": "CallbackUrls"},
        "LogoutURLs": {"Ref": "LogoutUrls"},
        "ExplicitAuthFlows": ["ALLOW_REFRESH_TOKEN_AUTH"],
        "PreventUserExistenceErrors": "ENABLED"
      }
    },
    "TrnUserPoolDomain": {
      "Type": "AWS::Cognito::UserPoolDomain",
      "Properties": {
        "Domain": {"Ref": "HostedUiDomainPrefix"},
        "UserPoolId": {"Ref": "TrnUserPool"}
      }
    }
  },
  "Outputs": {
    "UserPoolId": {
      "Value": {"Ref": "TrnUserPool"}
    },
    "UserPoolClientId": {
      "Value": {"Ref": "TrnUserPoolClient"}
    },
    "HostedUiDomain": {
      "Value": {"Fn::Sub": "https://${HostedUiDomainPrefix}.auth.${AWS::Region}.amazoncognito.com"}
    }
  }
}
